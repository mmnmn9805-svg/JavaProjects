class Animal {
    String name;
    int age;

    void eat() {
        System.out.println(name + " يأكل الطعام.");
    }

    void display() {
        System.out.println("الاسم: " + name + " | العمر: " + age);
    }
}

class Dog extends Animal {
    void bark() {
        System.out.println(name + " ينبح: هو هو!");
    }
}


class Cat extends Animal {
    void meow() {
        System.out.println(name + " يمؤو: مياو!");
    }
}

public class Main2 {
    public static void main(String[] args) {
        Dog dog = new Dog();
        dog.name = "ريكس";
        dog.age = 3;
        dog.display();
        dog.eat();
        dog.bark();

        System.out.println("-------------------");

        Cat cat = new Cat();
        cat.name = "مشمش";
        cat.age = 2;
        cat.display();
        cat.eat();
        cat.meow();
    }
}
